# Copiá este archivo a ".env" y completá con tus credenciales.
# Nunca subas tu ".env" real al repositorio (ya está en .gitignore).

# --- Embeddings (deben ser el MISMO modelo para indexar y para consultar) ---
# "huggingface" corre localmente, sin API key ni costo.
# "openai" usa la API de OpenAI (requiere OPENAI_API_KEY) y tiene costo mínimo.
EMBEDDINGS_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM de generación (independiente del proveedor de embeddings) ---
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=tu_api_key_de_anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0

# --- Ingesta / ChromaDB ---
DATA_DIR=./data
CHROMA_PERSIST_DIR=./vectorstore
CHROMA_COLLECTION=documentos_tecnicos
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- Recuperación ---
RAG_TOP_K=4

LOG_LEVEL=INFO
