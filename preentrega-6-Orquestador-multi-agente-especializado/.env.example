# Copiá este archivo a ".env" (sin el ".example") y completá tus valores.
# El ".env" real NUNCA se sube a git (ver .gitignore).

# Proveedor de LLM: "groq" (gratis, recomendado), "openai" o "anthropic".
LLM_PROVIDER=groq
LLM_TEMPERATURE=0

# --- Groq (gratis) --- conseguí tu key en https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI (opcional, solo si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (opcional, solo si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Búsqueda del Agente de Investigación ---
# "simulado" (default, gratis, sin red, busca sobre un corpus propio) o
# "tavily" (búsqueda web real, requiere TAVILY_API_KEY).
SEARCH_PROVIDER=simulado
TAVILY_API_KEY=

# --- Control de flujo del Supervisor ---
MAX_PASOS_SUPERVISOR=6
RECURSION_LIMIT=15
