# Copiá este archivo a ".env" (sin el ".example") y completá tus valores.
# El ".env" real NUNCA se sube a git (ver .gitignore).

# -- LLM --------------------------------------------------------------
# Proveedor: "groq" (gratis, recomendado), "openai" o "anthropic".
LLM_PROVIDER=groq
LLM_TEMPERATURE=0

# Groq (gratis) — conseguí tu key en https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=llama-3.3-70b-versatile

# Opcional, solo si LLM_PROVIDER=openai / anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# -- Búsqueda del Agente de Investigación ------------------------------
SEARCH_PROVIDER=simulado
TAVILY_API_KEY=

# -- Control de flujo del Supervisor -----------------------------------
MAX_PASOS_SUPERVISOR=6
RECURSION_LIMIT=40
AGENTE_RECURSION_LIMIT=10

# -- Redis --------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
JOB_TTL_SEGUNDOS=86400

# -- Observabilidad -------------------------------------------------------
OBSERVABILITY_PROVIDER=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=orquestador-multiagente

LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=orquestador-multiagente

# -- Modo demo (sin API key) ----------------------------------------------
DEMO_MODE=true
