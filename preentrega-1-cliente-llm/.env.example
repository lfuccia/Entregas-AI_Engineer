# Copiá este archivo a ".env" y completá los valores.
# ".env" está en .gitignore: nunca subas tus claves reales al repositorio.

# Proveedor a usar: "openai" o "anthropic"
LLM_PROVIDER=openai

# Modelo (opcional). Si no se especifica, se usa un default razonable
# según el proveedor: gpt-4o-mini para OpenAI, claude-sonnet-4-5 para Anthropic.
LLM_MODEL=gpt-4o-mini

# Parámetros de generación (opcionales)
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_MAX_RETRIES=2

# API keys: solo hace falta completar la del proveedor elegido en LLM_PROVIDER.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
