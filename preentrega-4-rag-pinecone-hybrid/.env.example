# Copiá este archivo a ".env" y completá con tus credenciales.
# Nunca subas tu ".env" real al repositorio (ya está en .gitignore).

# --- Pinecone ---
PINECONE_API_KEY=tu_api_key_de_pinecone
# Región del free tier de Pinecone Serverless (AWS us-east-1). Ajustá si
# tu proyecto de Pinecone usa otra cloud/región.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
INDEX_NAME=rag-documentacion-tecnica
# Namespace SIEMPRE explícito (evita mezclar datasets en el mismo índice).
PINECONE_NAMESPACE=documentacion-tecnica
PINECONE_METRIC=cosine

# --- Embeddings ---
# "huggingface" (default): sentence-transformers LOCAL, GRATIS, sin API key
# ni tarjeta de crédito. Ideal para probar todo el pipeline sin costo.
# "openai": text-embedding-3-small vía API, de pago (barato, mejor calidad).
EMBEDDINGS_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

OPENAI_API_KEY=tu_api_key_de_openai
EMBEDDING_MODEL=text-embedding-3-small

# Dimensión del modelo de embeddings elegido:
#   - all-MiniLM-L6-v2 (huggingface, default) -> 384
#   - text-embedding-3-small (openai)          -> 1536
# Tiene que coincidir con la dimensión del índice de Pinecone (recreando el
# índice si hace falta) o vas a pegar contra el "mismatch de dimensiones"
# que menciona el enunciado. Si dejás EMBEDDINGS_PROVIDER sin cambiar,
# podés dejar esta línea comentada: config.py calcula el default correcto
# (384 u 1536) según el proveedor.
# EMBEDDING_DIMENSION=384

# --- LLM de generación (OPCIONAL / bonus: el enunciado de esta pre-entrega
# no pide un paso de generación, solo recuperación + evaluación — esto es
# para poder probar el pipeline con una respuesta real de punta a punta).
# Groq: modelos open-source (Llama) con free tier real, sin tarjeta de
# crédito -> https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0

# --- Datos / chunking (punto medio recomendado: 500-800 tokens) ---
DATA_DIR=./data
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=80

# --- Corpus local (cache para BM25) ---
CORPUS_CACHE_PATH=./corpus_cache.jsonl

# --- Recuperación híbrida ---
RAG_TOP_K=5
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5

# --- Evaluación ---
GOLDEN_SET_PATH=./golden_set.json
EVAL_TOP_K=5

LOG_LEVEL=INFO
