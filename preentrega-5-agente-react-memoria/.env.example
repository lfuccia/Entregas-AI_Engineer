# Copiá este archivo a ".env" (sin el ".example") y completá tus valores.
# El ".env" real NUNCA se sube a git (ver .gitignore).

# Proveedor de LLM: "groq" (gratis, recomendado), "openai" o "anthropic".
LLM_PROVIDER=groq
LLM_TEMPERATURE=0

# --- Groq (gratis) --- conseguí tu key en https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI (opcional, solo si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (opcional, solo si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Persistencia ---
SQLITE_DB_PATH=checkpoints.sqlite

# --- Límite de pasos del grafo (evita bucles infinitos) ---
RECURSION_LIMIT=10
